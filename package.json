{
  "name": "inprime-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "test": "node --test tests/content.test.mjs",
    "check": "npm run format:check && npm run test && npm run typecheck && npm run generate && npm run test:output",
    "format:check": "prettier --check app shared server content scripts tests nuxt.config.ts vercel.json .github/workflows/ci.yml",
    "test:output": "node scripts/verify-output.mjs",
    "assets": "node scripts/fetch-assets.mjs",
    "prebuild": "npm run assets",
    "pregenerate": "npm run assets",
    "cms": "node scripts/cms.mjs",
    "format": "prettier --write app shared server content scripts tests nuxt.config.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "nuxt": "4.5.2",
    "vue": "3.5.43",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "decap-server": "3.11.3",
    "prettier": "3.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "vue-tsc": "~3.2.5"
  }
}
